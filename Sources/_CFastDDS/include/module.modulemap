module _CFastDDS [system] {
    requires cplusplus14

    header "common.h"
    header "fastdds.hpp"
    header "logging.hpp"
    header "type_representation.hpp"
    header "cdr_size.hpp"
    header "GenericTopicType.hpp"
    header "StatusMask.hpp"
    header "old/fastdds.hpp"
    header "participant.hpp"

    link "fastdds"
    link "fastcdr"
    link "BlocksRuntime"

    export *
}